{
  "name": "wandb-viewer",
  "displayName": "Bread Wandb Viewer",
  "description": "View Weights & Biases run metrics and logs directly in VS Code",
  "version": "0.3.2",
  "publisher": "bread-tech",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/erikscheurer/Bread-WandB-Viewer.git"
  },
  "homepage": "https://github.com/erikscheurer/Bread-WandB-Viewer#readme",
  "bugs": {
    "url": "https://github.com/erikscheurer/Bread-WandB-Viewer/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Machine Learning",
    "Data Science"
  ],
  "keywords": [
    "wandb",
    "weights and biases",
    "machine learning",
    "ml",
    "deep learning",
    "pytorch",
    "tensorflow",
    "training metrics",
    "visualization",
    "ai",
    "model training",
    "experiment tracking",
    "offline viewer",
    "protobuf",
    "data visualization",
    "data science",
    "machine learning",
    "ml",
    "deep learning",
    "pytorch",
    "tensorflow",
    "training metrics",
    "visualization",
    "open source",
    "training",
    "ml ops",
    "mlops",
    "ml operations",
    "ml engineering",
    "machine learning engineering"
  ],
  "activationEvents": [
    "onCustomEditor:wandb-viewer.wandbFile",
    "onCommand:wandb-viewer.compareRuns",
    "onCommand:wandb-viewer.addRunsToViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wandb-viewer.compareRuns",
        "title": "Open in New Wandb Viewer",
        "category": "Bread"
      },
      {
        "command": "wandb-viewer.addRunsToViewer",
        "title": "Add to Open Wandb Viewer",
        "category": "Bread"
      }
    ],
    "customEditors": [
      {
        "viewType": "wandb-viewer.wandbFile",
        "displayName": "Bread Wandb Viewer",
        "selector": [
          {
            "filenamePattern": "*.wandb"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "wandb-viewer.compareRuns",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "wandb-viewer.addRunsToViewer",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Bread Wandb Viewer",
      "properties": {
        "wandbViewer.defaultRunSort": {
          "type": "string",
          "default": "created-desc",
          "enum": [
            "created-desc",
            "created-asc",
            "name-asc",
            "name-desc",
            "updated-desc",
            "updated-asc"
          ],
          "enumDescriptions": [
            "Creation time, newest first",
            "Creation time, oldest first",
            "Run name, A–Z",
            "Run name, Z–A",
            "Latest update, newest first",
            "Latest update, oldest first"
          ],
          "description": "Default ordering of runs in a newly opened multi-run viewer. A sort selected in the viewer is remembered for that viewer."
        },
        "wandbViewer.runColorPalette": {
          "type": "string",
          "default": "tableau10",
          "enum": [
            "tableau10",
            "okabeIto",
            "observable10",
            "colorBrewerDark2",
            "colorBrewerSet1",
            "colorBrewerPaired",
            "tolBright",
            "tolVibrant",
            "tab20",
            "plotlyDark24",
            "plotlyAlphabet26",
            "glasbeyLightBackground64",
            "glasbeyDarkBackground64"
          ],
          "enumDescriptions": [
            "Balanced Tableau 10 colors",
            "Color-vision-deficiency-friendly Okabe–Ito colors",
            "Observable 10 categorical colors",
            "ColorBrewer Dark2 qualitative colors",
            "ColorBrewer Set1 qualitative colors",
            "ColorBrewer Paired qualitative colors",
            "Paul Tol Bright color-blind-safe line colors",
            "Paul Tol Vibrant color-blind-safe line colors",
            "Matplotlib tab20 colors",
            "Plotly Dark24 colors (24)",
            "Plotly Alphabet colors (26)",
            "Glasbey colors optimized for light chart backgrounds (64)",
            "Glasbey colors optimized for dark chart backgrounds (64)"
          ],
          "description": "Color palette used to assign stable colors to runs in multi-run charts. Colors are not reused until the selected palette is exhausted."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package:vsix": "bash scripts/package-vsix.sh"
  },
  "dependencies": {
    "protobufjs": "^7.2.6"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.0.0"
  }
}
